# ============================================================================
# Powerlevel10k Instant Prompt
# ============================================================================
# Must stay at the top for optimal performance
# Skip instant prompt in VSCode to avoid terminal echo issues
if [[ -z "$VSCODE_INJECTION" ]] && [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# ============================================================================
# Oh My Zsh Configuration
# ============================================================================
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"

# Plugins - dynamically load only installed ones
plugins=(git)

# Add optional plugins if installed
[[ -d "${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/plugins/zsh-completions" ]] && fpath+="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/plugins/zsh-completions/src"
[[ -d "$HOME/.dotfiles/completion" ]] && fpath+="$HOME/.dotfiles/completion"
[[ -d "${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/plugins/zsh-autosuggestions" ]] && plugins+=(zsh-autosuggestions)
[[ -d "${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/plugins/fast-syntax-highlighting" ]] && plugins+=(fast-syntax-highlighting)
[[ -d "${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/plugins/zsh-syntax-highlighting" ]] && plugins+=(zsh-syntax-highlighting)
[[ -d "${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/plugins/zsh-history-substring-search" ]] && plugins+=(zsh-history-substring-search)
[[ -d "${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/plugins/zsh-you-should-use" ]] && plugins+=(zsh-you-should-use)
[[ -d "${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/plugins/forgit" ]] && plugins+=(forgit)
[[ -d "$ZSH/plugins/kubectl" ]] && plugins+=(kubectl)
[[ -d "$ZSH/plugins/history-substring-search" ]] && plugins+=(history-substring-search)
[[ -d "$ZSH/plugins/sudo" ]] && plugins+=(sudo)
[[ -d "$ZSH/plugins/copybuffer" ]] && plugins+=(copybuffer)
[[ -d "$ZSH/plugins/jsontools" ]] && plugins+=(jsontools)

source $ZSH/oh-my-zsh.sh

# ============================================================================
# History Configuration
# ============================================================================
HISTSIZE=64000
SAVEHIST=64000
HISTFILE=~/.zsh_history
setopt EXTENDED_HISTORY          # Write timestamp to history
setopt INC_APPEND_HISTORY        # Write to history immediately
setopt SHARE_HISTORY             # Share history across sessions
setopt HIST_IGNORE_DUPS          # Don't record duplicates
setopt HIST_IGNORE_ALL_DUPS      # Delete old duplicates
setopt HIST_FIND_NO_DUPS         # Don't show duplicates in search
setopt HIST_REDUCE_BLANKS        # Remove superfluous blanks
setopt HIST_VERIFY               # Show command with history expansion before running

# ============================================================================
# Environment Variables
# ============================================================================
export USE_GKE_GCLOUD_AUTH_PLUGIN=True
export VIRTUAL_ENV_DISABLE_PROMPT=1
export GOPATH="$HOME/go"

# Editor preferences
export EDITOR='vim'
export VISUAL='vim'

# ============================================================================
# PATH Configuration (order matters - first has priority)
# ============================================================================
typeset -U path  # Automatically deduplicate PATH entries

path=(
  $HOME/.local/bin
  $HOME/.dotfiles/bin
  $GOPATH/bin
  /usr/local/git/current/bin
  /usr/local/go/bin
  /opt/homebrew/opt/fzf/bin
  /opt/homebrew/bin
  /opt/homebrew/sbin
  /usr/local/bin
  /usr/bin
  /bin
  /usr/local/sbin
  /usr/sbin
  /sbin
  $path
)

# ============================================================================
# Shared Aliases, Functions & Cloud Helpers (~/.dotfiles/shellconfig)
# ============================================================================
[ -f "$HOME/.dotfiles/shellconfig/funcs.sh" ] && source "$HOME/.dotfiles/shellconfig/funcs.sh"
[ -f "$HOME/.dotfiles/shellconfig/aliases.sh" ] && source "$HOME/.dotfiles/shellconfig/aliases.sh"
if [ "$(uname -s)" = "Darwin" ] && [ -f "$HOME/.dotfiles/shellconfig/aliases_mac.sh" ]; then
  source "$HOME/.dotfiles/shellconfig/aliases_mac.sh"
fi
[ -f "$HOME/.dotfiles/shellconfig/kubernetes.sh" ] && source "$HOME/.dotfiles/shellconfig/kubernetes.sh"
[ -f "$HOME/.dotfiles/shellconfig/agents.sh" ] && source "$HOME/.dotfiles/shellconfig/agents.sh"

# ============================================================================
# Tool Initialization
# ============================================================================

# pyenv - Properly initialize to enable Python version switching
if command -v pyenv 1>/dev/null 2>&1; then
  export PYENV_ROOT="$HOME/.pyenv"
  export PATH="$PYENV_ROOT/bin:$PATH"
  eval "$(pyenv init -)"
fi

# direnv - Per-directory environment management
if command -v direnv 1>/dev/null 2>&1; then
  eval "$(direnv hook zsh)"
fi

# fzf
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# stern log tool completion
if command -v stern &> /dev/null; then
  source <(stern --completion=zsh)
fi

# helm completion
if command -v helm &> /dev/null; then
  source <(helm completion zsh)
fi

# uv (Astral Python package & tool manager) completion
if command -v uv &> /dev/null; then
  eval "$(uv generate-shell-completion zsh 2>/dev/null)"
fi

# just command runner completion
if command -v just &> /dev/null; then
  eval "$(just --completions zsh 2>/dev/null)"
fi

# Google Cloud SDK path & completion (standalone or Homebrew)
for gcloud_sdk_dir in "$HOME/google-cloud-sdk" "/opt/homebrew/share/google-cloud-sdk" "/usr/local/share/google-cloud-sdk"; do
  if [ -d "$gcloud_sdk_dir" ]; then
    [ -f "$gcloud_sdk_dir/path.zsh.inc" ] && source "$gcloud_sdk_dir/path.zsh.inc"
    [ -f "$gcloud_sdk_dir/completion.zsh.inc" ] && source "$gcloud_sdk_dir/completion.zsh.inc"
    break
  fi
done

# ============================================================================
# Virtual Environment Management
# ============================================================================
# Prevent auto-activation of virtual environments from other projects
if [[ -n "$VIRTUAL_ENV" && ! "$PWD" =~ "$(dirname "$VIRTUAL_ENV")" ]]; then
    deactivate 2>/dev/null
fi

# ============================================================================
# Powerlevel10k Configuration
# ============================================================================
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# ============================================================================
# Local Configuration
# ============================================================================
# Source local config if it exists (for machine-specific settings)
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local
POWERLEVEL9K_DISABLE_CONFIGURATION_WIZARD=true