# ============================================================================
# Powerlevel10k Instant Prompt
# ============================================================================
# Must stay at the top for optimal performance
# Skip instant prompt in VSCode to avoid terminal echo issues
if [[ -z "$VSCODE_INJECTION" ]] && [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# ============================================================================
# Oh My Zsh Configuration
# ============================================================================
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"

# Plugins - dynamically load only installed ones
plugins=(git)

# Add optional plugins if installed
[[ -d "${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/plugins/zsh-autosuggestions" ]] && plugins+=(zsh-autosuggestions)
[[ -d "${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/plugins/zsh-syntax-highlighting" ]] && plugins+=(zsh-syntax-highlighting)
[[ -d "$ZSH/plugins/kubectl" ]] && plugins+=(kubectl)
[[ -d "$ZSH/plugins/history-substring-search" ]] && plugins+=(history-substring-search)
[[ -d "$ZSH/plugins/sudo" ]] && plugins+=(sudo)
[[ -d "$ZSH/plugins/copybuffer" ]] && plugins+=(copybuffer)
[[ -d "$ZSH/plugins/jsontools" ]] && plugins+=(jsontools)

source $ZSH/oh-my-zsh.sh

# ============================================================================
# History Configuration
# ============================================================================
HISTSIZE=50000
SAVEHIST=50000
HISTFILE=~/.zsh_history
setopt EXTENDED_HISTORY          # Write timestamp to history
setopt INC_APPEND_HISTORY        # Write to history immediately
setopt SHARE_HISTORY             # Share history across sessions
setopt HIST_IGNORE_DUPS          # Don't record duplicates
setopt HIST_IGNORE_ALL_DUPS      # Delete old duplicates
setopt HIST_FIND_NO_DUPS         # Don't show duplicates in search
setopt HIST_IGNORE_SPACE         # Don't record commands starting with space
setopt HIST_REDUCE_BLANKS        # Remove superfluous blanks
setopt HIST_VERIFY               # Show command with history expansion before running

# ============================================================================
# Environment Variables
# ============================================================================
export USE_GKE_GCLOUD_AUTH_PLUGIN=True
export CLAUDE_CODE_USE_VERTEX=1
export CLOUD_ML_REGION=us-east5
export ANTHROPIC_VERTEX_PROJECT_ID=conventodapenha
export VIRTUAL_ENV_DISABLE_PROMPT=1

# Editor preferences
export EDITOR='vim'
export VISUAL='vim'

# ============================================================================
# PATH Configuration (order matters - first has priority)
# ============================================================================
typeset -U path  # Automatically deduplicate PATH entries

path=(
  $HOME/.antigravity/antigravity/bin
  $HOME/.jetski/jetski/bin
  $HOME/.codeium/windsurf/bin
  $HOME/.local/bin
  $HOME/Library/Python/3.9/bin
  /opt/homebrew/opt/fzf/bin
  /opt/homebrew/bin
  /usr/local/go/bin
  /usr/local/bin
  /usr/local/git/current/bin
  /usr/bin
  /bin
  /usr/local/sbin
  /usr/sbin
  /sbin
  $path
)

# ============================================================================
# Aliases
# ============================================================================
# DO NOT alias python/pip - let pyenv manage these
# alias python=python3
# alias pip=pip3

# Common shortcuts
alias ll='ls -lah'
alias la='ls -A'
alias l='ls -CF'
alias ..='cd ..'
alias ...='cd ../..'

# Git aliases (if you want more than oh-my-zsh provides)
alias gs='git status'
alias gp='git pull'
alias gc='git commit'
alias gca='git commit -a'

# Safety aliases
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'

# Kubernetes shortcuts
alias k='kubectl'
alias kgp='kubectl get pods'
alias kgs='kubectl get services'
alias kgd='kubectl get deployments'

# ============================================================================
# Functions
# ============================================================================

# Create directory and cd into it
mkcd() {
  mkdir -p "$1" && cd "$1"
}

# Quick find
qfind() {
  find . -name "*$1*"
}

# Extract various archive formats
extract() {
  if [ -f $1 ]; then
    case $1 in
      *.tar.bz2)   tar xjf $1     ;;
      *.tar.gz)    tar xzf $1     ;;
      *.bz2)       bunzip2 $1     ;;
      *.rar)       unrar e $1     ;;
      *.gz)        gunzip $1      ;;
      *.tar)       tar xf $1      ;;
      *.tbz2)      tar xjf $1     ;;
      *.tgz)       tar xzf $1     ;;
      *.zip)       unzip $1       ;;
      *.Z)         uncompress $1  ;;
      *.7z)        7z x $1        ;;
      *)           echo "'$1' cannot be extracted via extract()" ;;
    esac
  else
    echo "'$1' is not a valid file"
  fi
}

# ============================================================================
# Tool Initialization (Lazy Loading for Performance)
# ============================================================================

# NVM - Lazy load for faster shell startup
export NVM_DIR="$HOME/.nvm"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  # Don't load nvm immediately, load on first use
  nvm() {
    unset -f nvm node npm
    [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
    [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
    nvm "$@"
  }

  node() {
    unset -f nvm node npm
    [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
    [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
    node "$@"
  }

#  npm() {
#    unset -f nvm node npm
#    [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
#    [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
#    npm "$@"
#  }
fi

# pyenv - Properly initialize to enable Python version switching
if command -v pyenv 1>/dev/null 2>&1; then
  export PYENV_ROOT="$HOME/.pyenv"
  export PATH="$PYENV_ROOT/bin:$PATH"
  eval "$(pyenv init -)"
fi

# fzf
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# kubectl completion (modern approach)
if command -v kubectl &> /dev/null; then
  source <(kubectl completion zsh)
fi

# ============================================================================
# Virtual Environment Management
# ============================================================================
# Prevent auto-activation of virtual environments from other projects
if [[ -n "$VIRTUAL_ENV" && ! "$PWD" =~ "$(dirname "$VIRTUAL_ENV")" ]]; then
    deactivate 2>/dev/null
fi

# ============================================================================
# Powerlevel10k Configuration
# ============================================================================
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# ============================================================================
# Local Configuration
# ============================================================================
# Source local config if it exists (for machine-specific settings)
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local
POWERLEVEL9K_DISABLE_CONFIGURATION_WIZARD=true