# Ghostty Terminal Configuration
# Inspired by Mitchell Hashimoto's Ghostty workflow + Nerd Font & Agentic Split setup

font-family = "MesloLGS NF"
font-size = 13

# Visuals & Window
theme = Catppuccin Mocha
background-opacity = 0.96
background-blur-radius = 20
macos-non-native-fullscreen = visible-menu
macos-option-as-alt = true
mouse-hide-while-typing = true
window-save-state = always
scrollback-limit = 10000000

# Agentic Workflow: Disable intrusive desktop notifications from background agents
# (Stay in control of context switching; check agent splits during natural breaks)
desktop-notifications = false

# Clipboard & Font Sizing
keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard
keybind = super+equal=increase_font_size:1
keybind = super+minus=decrease_font_size:1
keybind = super+zero=reset_font_size

# Window, Tab & Config Management
keybind = super+shift+comma=reload_config
keybind = super+k=clear_screen
keybind = super+n=new_window
keybind = super+t=new_tab
keybind = super+w=close_surface
keybind = super+shift+w=close_window
keybind = super+shift+left_bracket=previous_tab
keybind = super+shift+right_bracket=next_tab

# Fast Split Management (Human code on left, Agent / Logs on right)
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+right_bracket=goto_split:next
keybind = super+left_bracket=goto_split:previous
keybind = super+shift+enter=toggle_split_zoom

# Remote Tmux Tab & Split Management (Option/Alt mirrors Cmd shortcuts -> sends Ctrl-A prefix to tmux)
keybind = alt+t=text:\x01c
keybind = alt+d=text:\x01|
keybind = alt+shift+d=text:\x01-
keybind = alt+w=text:\x01x
keybind = alt+shift+left_bracket=text:\x01p
keybind = alt+shift+right_bracket=text:\x01n

